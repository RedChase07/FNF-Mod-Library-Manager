<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FnFModLibrary_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FnFModLibrary_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#091520" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#122432" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#203746" />
            <SolidColorBrush x:Key="AccentBrush" Color="#54B8E8" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EFF9FF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9BB6C7" />
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#183B53" />
            <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F0FAFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#286080" />
            <local:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
